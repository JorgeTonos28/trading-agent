{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "r006-spine-1"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "PORTFOLIO_SHADOW"
      ]
    },
    "authority": {
      "type": "string",
      "enum": [
        "NONE"
      ]
    },
    "snapshot_id": {
      "type": "string"
    },
    "snapshot_hash": {
      "type": "string"
    },
    "decision_at": {
      "type": "string"
    },
    "knowledge_asof": {
      "type": "string"
    },
    "content_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "INSUFFICIENT_EVIDENCE",
        "ABSTAIN"
      ]
    },
    "procedure_marker": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "value": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "fact_id",
          "source_id",
          "field",
          "value",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "calculation_id": {
            "type": "string"
          },
          "formula": {
            "type": "string",
            "enum": [
              "cash_minus_reservations@toy-1",
              "quantity_times_price@toy-1"
            ]
          },
          "input_fact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "calculation_id",
          "formula",
          "input_fact_ids",
          "result",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "SHADOW"
          ]
        },
        "proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instrument_id": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "enum": [
                  "OPEN",
                  "INCREASE",
                  "REDUCE",
                  "CLOSE",
                  "HOLD"
                ]
              },
              "target_quantity": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              },
              "target_notional_calculation_id": {
                "type": "string"
              },
              "priority": {
                "type": "integer",
                "minimum": 1
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "type": "null"
              }
            },
            "required": [
              "instrument_id",
              "action",
              "target_quantity",
              "target_notional_calculation_id",
              "priority",
              "reasons",
              "source_ids",
              "confidence"
            ],
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode",
        "proposals",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "role",
    "authority",
    "snapshot_id",
    "snapshot_hash",
    "decision_at",
    "knowledge_asof",
    "content_status",
    "procedure_marker",
    "facts",
    "calculations",
    "unknowns",
    "payload"
  ],
  "additionalProperties": false
}
